{
  "name": "minecraft-dev-starter",
  "version": "0.1.4",
  "private": false,
  "description": "DSH plugin that detects Minecraft mod projects and launches the client from the session header, with live logs in the sidebar",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "minecraft",
    "modding",
    "gradle",
    "fabric",
    "neoforge",
    "forge"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chemiofitor4096/minecraft-dev-starter.git"
  },
  "homepage": "https://github.com/Chemiofitor4096/minecraft-dev-starter#readme",
  "bugs": {
    "url": "https://github.com/Chemiofitor4096/minecraft-dev-starter/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "esbuild": "^0.28.2"
  }
}
